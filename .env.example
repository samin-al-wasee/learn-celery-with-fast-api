# Copy to .env and adjust values. Never commit .env.
POSTGRES_USER=cardicheck
POSTGRES_PASSWORD=cardicheck
POSTGRES_DB=cardicheck

# Used by the FastAPI app (host-side: containers publish on localhost)
DATABASE_URL=postgresql+asyncpg://cardicheck:cardicheck@localhost:5432/cardicheck

# M2: caching (Redis). Installer redis on host :6379.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60
CACHE_TTL_JITTER=0.1

# JWT signing (generate a strong value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`)
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60