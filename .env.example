# Copy to .env and adjust values. Never commit .env.
POSTGRES_USER=cardicheck
POSTGRES_PASSWORD=cardicheck
POSTGRES_DB=cardicheck

# Used by the FastAPI app (host-side: containers publish on localhost)
DATABASE_URL=postgresql+asyncpg://cardicheck:cardicheck@localhost:5432/cardicheck

# M2: caching (Redis). Installer redis on host :6379.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60
CACHE_TTL_JITTER=0.1

# M3: Celery broker (RabbitMQ)
CELERY_BROKER_URL=amqp://cardicheck:cardicheck@localhost:5672//
# Flower basic auth as user:password (generate a strong password; never commit it)
FLOWER_BASIC_AUTH=admin:change-me
RABBITMQ_MANAGEMENT_URL=http://cardicheck:cardicheck@localhost:15672/api/
RABBITMQ_BLOCKED_TIMEOUT_SECONDS=2.0

# M3: appointment reminders
REMINDER_LEAD_SECONDS=86400
REMINDER_SCAN_SECONDS=60

# M3: record exports
EXPORT_DIR=.outbox/exports

# M5: notifications consumer
NOTIFY_PROCESS_SECONDS=0.05
NOTIFY_OUTBOX_DIR=.outbox/notifications
NOTIFY_ACK_DELAY_SECONDS=0.0

# M3: fake SMTP for the welcome-email job
EMAIL_SEND_SECONDS=2.0
EMAIL_FAIL_RATE=0.0
EMAIL_ACK_SECONDS=0.0
EMAIL_OUTBOX_DIR=.outbox/emails

# JWT signing (generate a strong value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`)
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60