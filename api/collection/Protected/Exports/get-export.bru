meta {
  name: Get Export
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/exports/{{export_job_id}}
  body: none
  auth: inherit
}

script:pre-request {
  // Poll with a deadline instead of a fixed sleep: the first publish from a cold API
  // took ~1s to reach the worker, and a fixed 1.5s wait flaked.
  const url = `${bru.getEnvVar('baseUrl')}/api/v1/exports/${bru.getVar('export_job_id')}`;
  const headers = { Authorization: `Bearer ${bru.getVar('access_token')}` };
  for (let i = 0; i < 40; i++) {
    const r = await bru.sendRequest({ method: 'GET', url, headers });
    const s = r.data && r.data.data ? r.data.data.status : null;
    if (s !== 'queued' && s !== 'running') break;
    await bru.sleep(250);
  }
}

assert {
  res.status: eq 200
  res.body.error: isNull
  res.body.data.id: eq {{export_job_id}}
  res.body.data.status: eq "succeeded"
  res.body.data.row_count: isNumber
  res.body.data.download_url: isString
}
