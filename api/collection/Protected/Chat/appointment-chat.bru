meta {
  name: Appointment Chat (WebSocket)
  type: ws
  seq: 1
  tags: [
    ws
  ]
}

ws {
  url: ws://localhost:8000/api/v1/ws/appointments/{{appt_id}}/chat
  auth: none
}

body:ws {
  name: auth
  type: json
  content: '''
    {"type": "auth", "token": "{{access_token}}"}
  '''
  selected: true
}

docs {
  Doctor/patient chat for one appointment (M4). The first frame must be
  {"type": "auth", "token": "<jwt>"} within 5s (never ?token= in the URL: uvicorn logs the path);
  (add "last_seen_id": <id> on reconnect to replay what you missed), then send
  {"type": "message", "text": "hi", "client_msg_id": "<uuid>"}; a retry with the same
  client_msg_id is stored once and answered with {"type": "ack"}. Non-participants are closed with 1008.
  Messages fan out across API processes via Redis pub/sub.
  Bruno CLI 4.2 does not execute ws requests; run this in the Bruno app.
  Headless check: python scripts/observe_chat.py.
}
