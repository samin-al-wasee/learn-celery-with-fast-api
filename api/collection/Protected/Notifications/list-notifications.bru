meta {
  name: List Notifications
  type: http
  seq: 1
  tags: [
    service
  ]
}

get {
  url: {{notificationsUrl}}/api/v1/notifications?limit=50
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.error: isNull
  res.body.data: isArray
  res.body.meta: isDefined
}

docs {
  The caller's in-app notifications, newest first, keyset-paged via meta.next_before_id (M5).
  Served by the notifications SERVICE (M6: own process + own database), not the monolith:
  uvicorn services.notifications.api:app --port 8300. It validates the monolith-issued JWT itself.
  Rows come from python -m services.notifications.consumer (appointment.* events, inbox dedup).
  Tag `service`: excluded from verify.ps1 -Bruno until the gateway puts it behind baseUrl.
}
