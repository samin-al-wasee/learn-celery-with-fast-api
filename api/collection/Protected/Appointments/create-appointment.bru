meta {
  name: Create Appointment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/appointments
  body: json
  auth: inherit
}

script:pre-request {
  // Scheduled_at must be in the future; compute +1h so the example never
  // trips the PAST_SCHEDULED_AT check. (Bruno's var panel keeps re-pinning
  // vars:pre-request { appt_at: 7 } — remove it if it reappears.)
  const d = new Date(Date.now() + 60 * 60 * 1000);
  bru.setVar('appt_at', d.toISOString());
}

body:json {
  {
    "patient_id": {{signup_patient_id}},
    "scheduled_at": "{{appt_at}}",
    "reason": "Follow-up on blood pressure"
  }
}

assert {
  res.status: eq 201
  res.body.data.id: isNumber
  res.body.data.status: eq "pending"
  res.body.data.scheduled_at: isString
}

script:post-response {
  if (res.status !== 201) return;
  const data = res.getBody().data;
  bru.setVar('appt_id', data.id);
}