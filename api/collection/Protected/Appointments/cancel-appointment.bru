meta {
  name: Cancel Appointment
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/appointments/{{appt_id}}/cancel
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.error: isNull
  res.body.data.status: eq "cancelled"
}

docs {
  A real transition stages appointment.cancelled in the outbox (M6); repeating the cancel is a no-op and publishes nothing.
}
