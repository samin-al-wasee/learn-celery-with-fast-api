meta {
  name: Patch Record
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/records/{{record_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Updated Title"
  }
}

assert {
  res.status: eq 200
  res.body.data.title: eq "Updated Title"
  res.body.data.notes: contains "steady chest pain"
}