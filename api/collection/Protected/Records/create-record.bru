meta {
  name: Create Record
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/records
  body: json
  auth: inherit
}

body:json {
  patient_id: {{signup_patient_id}}
  title: Initial Consult
  notes: Patient reports steady chest pain.
}

assert {
  res.status: eq 201
  res.body: contains "data"
  res.body: contains "Initial Consult"
}

script:post-response {
  if (res.status !== 201) return;
  const data = res.getBody().data;
  bru.setVar('record_id', data.id);
}