meta {
  name: Signup Doctor
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "dr.smith@cardicheck.io",
    "password": "supersecret1",
    "full_name": "Dr. Alice Smith",
    "role": "doctor",
    "specialty": "Cardiology"
  }
}

assert {
  res.status: eq 201
  res.body: contains "id"
  res.body: contains "doctor"
}