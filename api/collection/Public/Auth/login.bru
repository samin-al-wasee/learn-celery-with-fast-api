meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{signup_email}}",
    "password": "supersecret1"
  }
}

assert {
  res.status: eq 200
  res.body: contains "access_token"
  res.body: contains "bearer"
}

script:post-response {
  const data = res.getBody();
  bru.setVar('access_token', data.access_token);
}
