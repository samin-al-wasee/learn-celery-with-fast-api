meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{signup_email}}",
    "password": "supersecret1"
  }
}

assert {
  res.status: eq 200
  res.body: contains "data"
  res.body: contains "access_token"
  res.body: contains "bearer"
}

script:pre-request {
  // Always start empty: never let a stale/expired token leak into a new login
  // attempt, and if this login fails the protected tree gets no token at all.
  bru.setVar('access_token', '');
}

script:post-response {
  if (res.status !== 200) return;
  const data = res.getBody();
  bru.setVar('access_token', data.access_token);
  // signup_email is consumed: the account now exists, so clear it for a
  // fresh cycle (signup -> capture -> login -> cleared).
  bru.setVar('signup_email', '');
}
