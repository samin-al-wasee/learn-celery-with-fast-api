meta {
  name: Login (wrong password)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{$randomFirstName}}.{{$guid}}@cardicheck.io",
    "password": "definitely-wrong"
  }
}

assert {
  res.status: eq 401
  res.body.error.code: eq "INVALID_CREDENTIALS"
}

docs {
  Failed logins are counted per client IP + email in Redis (M8), shared by every API process.
  After LOGIN_MAX_FAILURES (5) within LOGIN_WINDOW_SECONDS (60) the next attempts get
  429 TOO_MANY_ATTEMPTS with a Retry-After header, before any argon2 work happens.
  Headless check across two processes + restart: python scripts/observe_rate_limit.py
}
