meta {
  name: Signup Patient
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "{{$randomFirstName}}.{{$randomLastName}}@cardicheck.io",
    "password": "supersecret1",
    "full_name": "{{$randomFirstName}} {{$randomLastName}}",
    "role": "patient"
  }
}

assert {
  res.status: eq 201
  res.body: contains "data"
  res.body: contains "id"
  res.body: contains "patient"
}

script:post-response {
  if (res.status !== 201) return;
  const data = res.getBody().data;
  bru.setVar('signup_patient_id', data.id);
}