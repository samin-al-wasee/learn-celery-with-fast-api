meta {
  name: Signup Doctor
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "dr.{{$randomFirstName}}.{{$guid}}@cardicheck.io",
    "password": "supersecret1",
    "full_name": "Dr. {{$randomFirstName}} {{$randomLastName}}",
    "role": "doctor",
    "specialty": "Cardiology"
  }
}

script:post-response {
  if (res.status !== 201) return;
  const data = res.getBody().data;
  bru.setVar('signup_email', data.email);
  bru.setVar('signup_doctor_id', data.id);
}

assert {
  res.status: eq 201
  res.body.error: isNull
  res.body.data.id: isNumber
  res.responseTime: lt 1000
  res.body.data.role: eq "doctor"
}

docs {
  Enqueues a welcome email as a Celery task (M3). The ~2s send runs on the worker,
  so signup stays fast: the responseTime assert fails if email ever moves back onto the request path.
}
