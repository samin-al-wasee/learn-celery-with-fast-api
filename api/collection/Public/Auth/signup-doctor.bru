meta {
  name: Signup Doctor
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "dr.{{$randomFirstName}}.cardio@cardicheck.io",
    "password": "supersecret1",
    "full_name": "Dr. {{$randomFirstName}} {{$randomLastName}}",
    "role": "doctor",
    "specialty": "Cardiology"
  }
}

script:post-response {
  const data = res.getBody();
  bru.setVar('signup_email', data.email);
}

assert {
  res.status: eq 201
  res.body: contains "id"
  res.body: contains "doctor"
}